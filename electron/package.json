{
  "name": "dlotus-pdv-desktop",
  "productName": "D'Lotus PDV",
  "version": "1.1.3",
  "description": "D'Lotus Lounge Bar — Sistema PDV Desktop (offline-first)",
  "main": "main.js",
  "author": "D'Lotus Lounge Bar",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.dlotus.pdv",
    "productName": "D'Lotus PDV",
    "copyright": "© 2026 D'Lotus Lounge Bar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "D-Lotus-PDV-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "D'Lotus PDV",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  },
  "dependencies": {
    "asar": "^3.2.0"
  }
}
